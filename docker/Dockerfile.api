# Imagem da API de inferência (/health, /classify).
# Construir a partir da raiz do repositório:
#   docker build -f docker/Dockerfile.api -t flight-delay-api .
# Correr com o modelo dummy (sem MLflow):
#   docker run -p 8000:8000 flight-delay-api
# Correr com um modelo do MLflow:
#   docker run -p 8000:8000 -e MODEL_URI=models:/<nome>@<alias> \
#     -e MLFLOW_TRACKING_URI=http://<IP-VM1>:5000 flight-delay-api

FROM python:3.11-slim

# Não criar ficheiros .pyc; mostrar os logs logo, sem buffer.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# Instalar as dependências antes de copiar o código. Assim o Docker reaproveita
# esta camada (cache) quando só o código muda e o requirements.txt não.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar só o código da aplicação (o .dockerignore exclui dados, testes, docs...).
COPY src/ ./src/

# O Docker verifica sozinho se a API responde (estado "healthy" no docker ps).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)"

CMD ["uvicorn", "flight_delay.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
