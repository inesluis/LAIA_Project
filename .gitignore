# ── Dados (grandes; ficam fora do Git, ou no DVC) ──
data/**
!data/**/
!data/**/.gitkeep
*.zip
*.parquet
*.csv
!tests/fixtures/*.csv

# ── Modelos e artefactos de treino ──
models/
artifacts/
*.pkl
*.joblib
*.onnx
*.lgb

# ── MLflow local (o tracking oficial está no servidor da VM1) ──
mlruns/
mlartifacts/
mlflow.db

# ── Segredos (usar GitHub Secrets, nunca o repositório) ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ── Testes, lint e cobertura ──
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Notebooks ──
.ipynb_checkpoints/

# ── DVC (cache local; os ficheiros .dvc e dvc.lock vão para o Git) ──
/.dvc/cache
/.dvc/tmp

# ── Monitorização local ──
deploy/grafana/data/
deploy/prometheus/data/

# ── Editores e sistema operativo ──
.vscode/
.idea/
.DS_Store
Thumbs.db
